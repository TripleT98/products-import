{
  "name": "product-import/backend",
  "description": "Slim API for asynchronous product imports",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "~8.4.0",
    "brick/math": "~1.0.0",
    "doctrine/dbal": "~4.5.0",
    "doctrine/migrations": "~3.9.8",
    "doctrine/orm": "~3.7.6",
    "firebase/php-jwt": "~7.2.1",
    "phpoffice/phpspreadsheet": "~5.10.0",
    "slim/psr7": "^1.8.0",
    "slim/slim": "^4.15.3",
    "symfony/amqp-messenger": "~8.1.10",
    "symfony/cache": "~8.1.10",
    "symfony/event-dispatcher": "~8.1.5",
    "symfony/messenger": "~8.1.10"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "Migrations\\": "migrations/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {},
    "platform": {
      "php": "8.4.27"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^13.4.5",
    "phpstan/phpstan": "^2.3.4",
    "friendsofphp/php-cs-fixer": "^3.95.27",
    "phpstan/phpstan-doctrine": "^2.1.0"
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --no-progress --memory-limit=512M",
    "style": "php-cs-fixer fix --dry-run --diff",
    "format": "php-cs-fixer fix",
    "check": [
      "@composer validate --strict",
      "@analyse",
      "@style"
    ]
  }
}
