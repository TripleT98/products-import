# Dedicated Compose project: scopes service names and persistent volumes.
COMPOSE_PROJECT_NAME=product-import
# Bind the development site only to loopback; port may be changed.
HTTP_PORT=8080
# Production mode; fixtures/inspection require explicit command-scoped development/test.
APP_ENV=production
# Optional public infrastructure probe. Use /api/health for readiness.
APP_DIAGNOSTICS_ENABLED=false
# PostgreSQL internal connection. Password is a local example, replace before use.
DB_HOST=db
DB_PORT=5432
POSTGRES_DB=product_import
POSTGRES_USER=product_import
POSTGRES_PASSWORD=change-me-local-db
# RabbitMQ internal connection and initial account; no host broker ports are exposed.
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=product_import
RABBITMQ_DEFAULT_PASS=change-me-local-broker
RABBITMQ_DEFAULT_VHOST=/
# Container paths shared by app/worker (images are read-only for nginx).
UPLOAD_DIR=/var/app/uploads
IMAGE_DIR=/var/app/images

# JWT HS256 signing key: set a randomly generated value of at least 32 bytes.
JWT_SECRET=
JWT_ISSUER=product-import
JWT_AUDIENCE=product-import-web
# Token lifetime in seconds (1..86400); no refresh endpoint.
JWT_TTL_SECONDS=3600

# XLSX limits shared by upload preflight, reader and worker.
XLSX_MAX_FILE_BYTES=10485760
XLSX_MAX_UNCOMPRESSED_BYTES=104857600
XLSX_MAX_ZIP_ENTRIES=1000
XLSX_MAX_COMPRESSION_RATIO=100
XLSX_MAX_DATA_ROWS=10000
XLSX_MAX_ROW_NUMBER=100001
XLSX_CHUNK_ROWS=250

# Image downloads: DNS + all HTTP hops share total network time; no private-address switch.
IMAGE_MAX_BYTES=5242880
IMAGE_CONNECT_TIMEOUT_MS=3000
IMAGE_TOTAL_TIMEOUT_MS=10000
IMAGE_MAX_REDIRECTS=3
IMAGE_MAX_PIXELS=12000000
IMAGE_MAX_DIMENSION=10000
IMAGE_MAX_HEADER_BYTES=16384

# T15 Messenger worker. Retry max=3, multiplier=2, delay cap=60000 ms.
IMPORT_LEASE_SECONDS=60
IMPORT_RETRY_DELAY_MS=1000
IMPORT_QUEUE_PREFIX=product_import

# Shared PostgreSQL upload limiter: authenticated attempts, including invalid files.
IMPORT_RATE_LIMIT=5
IMPORT_RATE_WINDOW_SECONDS=60
